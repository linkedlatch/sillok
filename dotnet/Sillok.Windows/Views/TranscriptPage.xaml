<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sillok.Windows.Views.TranscriptPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sillok.Windows">

    <Grid Padding="24,16,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind Item.Name, Mode=OneWay}"
                TextTrimming="CharacterEllipsis" />
            <CommandBar Grid.Column="1" DefaultLabelPosition="Right">
                <AppBarButton
                    Click="OnPause"
                    Icon="Pause"
                    Label="일시 정지"
                    Visibility="{x:Bind Model.PauseVisibility, Mode=OneWay}" />
                <AppBarButton Icon="Share" Label="내보내기">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Click="OnExportText" Text="텍스트 (.txt)" />
                            <MenuFlyoutItem Click="OnExportSubRip" Text="자막 (.srt)" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4" Visibility="{x:Bind Item.ProgressVisibility, Mode=OneWay}">
            <TextBlock Text="{x:Bind Item.StatusText, Mode=OneWay}" />
            <ProgressBar Maximum="100" Value="{x:Bind Item.ProgressValue, Mode=OneWay}" />
        </StackPanel>

        <ListView
            x:Name="SegmentList"
            Grid.Row="2"
            ItemsSource="{x:Bind Item.Rows, Mode=OneWay}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SegmentRow">
                    <Grid>
                        <Border
                            Margin="-8,0"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Opacity="{x:Bind HighlightOpacity, Mode=OneWay}" />
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <HyperlinkButton
                                Padding="4,0"
                                VerticalAlignment="Top"
                                Click="OnPlay"
                                Content="{x:Bind TimeText}"
                                FontFamily="Consolas"
                                Tag="{x:Bind Segment.Start}"
                                ToolTipService.ToolTip="이 위치부터 재생" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,4,0,0"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind SpeakerText}"
                                Visibility="{x:Bind SpeakerVisibility}" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="0,2,0,0"
                                IsTextSelectionEnabled="True"
                                Opacity="{x:Bind TextOpacity}"
                                Text="{x:Bind Text}"
                                TextWrapping="Wrap" />
                            <FontIcon
                                Grid.Column="3"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE9CE;"
                                ToolTipService.ToolTip="인식 신뢰도가 낮은 구간입니다. 원본을 들어 확인해 주세요"
                                Visibility="{x:Bind LowConfidenceVisibility}" />
                            <TextBlock
                                Grid.Column="4"
                                Margin="0,4,0,0"
                                FontFamily="Consolas"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Language}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
