<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sillok.App.Pages.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="640" Margin="24" Spacing="16">
            <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="FileName" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
            <RadioButtons x:Name="Language" />
            <ToggleSwitch x:Name="Diarize" />
            <TextBox x:Name="Glossary" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" />
            <RadioButtons x:Name="Device" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="OnStart" />
                <Button x:Name="CancelButton" Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
