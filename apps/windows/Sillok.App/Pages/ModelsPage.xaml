<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sillok.App.Pages.ModelsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="640" Margin="24" Spacing="16">
            <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="Body" TextWrapping="Wrap" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" />
            <ProgressBar x:Name="Bar" Maximum="1" />
            <TextBlock x:Name="Status" Style="{StaticResource CaptionTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="DownloadButton" Style="{StaticResource AccentButtonStyle}" Click="OnDownload" />
                <Button x:Name="StopButton" Click="OnStop" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
