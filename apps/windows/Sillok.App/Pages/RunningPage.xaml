<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sillok.App.Pages.RunningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="640" Margin="24" Spacing="16">
            <TextBlock x:Name="Heading" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock x:Name="FileName" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
            <StackPanel x:Name="Steps" Spacing="12" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CancelButton" Click="OnCancel" />
                <Button x:Name="BackButton" Click="OnBack" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
