<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sillok.App.Pages.ResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sillok.App.Pages">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="24,12,24,12" RowSpacing="8">
        <CommandBar DefaultLabelPosition="Right" HorizontalAlignment="Left">
            <AppBarButton x:Name="BackButton" Icon="Back" Click="OnBack" />
            <AppBarButton x:Name="SpeakersButton" Icon="People" Click="OnSpeakers" />
            <AppBarButton x:Name="ExportButton" Icon="Save">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem x:Name="ExportTxt" Tag="txt" Click="OnExport" />
                        <MenuFlyoutItem x:Name="ExportSrt" Tag="srt" Click="OnExport" />
                        <MenuFlyoutItem x:Name="ExportJson" Tag="json" Click="OnExport" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton x:Name="InfoButton" Icon="More" Click="OnInfo" />
        </CommandBar>
        <TextBlock x:Name="Heading" Grid.Row="1" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Message" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <ListView x:Name="Segments" Grid.Row="2" SelectionMode="Single" IsItemClickEnabled="True" ItemClick="OnSegmentClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:SegmentRow">
                    <StackPanel Padding="0,6">
                        <TextBlock Text="{x:Bind Header}" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid x:Name="Player" Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
            <Button x:Name="PlayButton" Click="OnPlayPause">
                <SymbolIcon x:Name="PlayIcon" Symbol="Play" />
            </Button>
            <TextBlock x:Name="Position" Grid.Column="1" VerticalAlignment="Center" />
            <Slider x:Name="Seek" Grid.Column="2" VerticalAlignment="Center" IsThumbToolTipEnabled="False" ValueChanged="OnSeek" />
            <TextBlock x:Name="Length" Grid.Column="3" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
