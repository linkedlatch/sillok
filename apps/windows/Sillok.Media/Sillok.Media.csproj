<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows' media APIs (Media Foundation) for the app: decoding audio and
       video files, and writing the listening copy. Builds on any OS; runs
       on Windows only. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Sillok.Media</RootNamespace>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sillok.Core\Sillok.Core.csproj" />
  </ItemGroup>
</Project>
