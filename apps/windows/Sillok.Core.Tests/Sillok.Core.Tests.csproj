<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs against the sillok library in SILLOK_NATIVE_DIR (a CMake build
       directory's library: sillok.dll, libsillok.so). The real-model test
       also needs SILLOK_MODELS and SILLOK_SPEECH (a 16-bit WAV). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Test method names describe behaviour in words. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sillok.Core\Sillok.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
