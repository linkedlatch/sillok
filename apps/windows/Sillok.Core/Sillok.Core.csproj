<Project Sdk="Microsoft.NET.Sdk">
  <!-- The app's platform-neutral part: the sillok C ABI, models, history.
       It builds and tests on any OS against that OS's sillok library. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Sillok</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Sillok.Core.Tests" />
  </ItemGroup>
</Project>
