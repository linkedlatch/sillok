<Project Sdk="Microsoft.NET.Sdk">
  <!-- Media Foundation on Windows: decoding and the listening copy. The
       real-model test needs SILLOK_NATIVE_DIR, SILLOK_MODELS and SILLOK_SPEECH
       as Sillok.Core.Tests does. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sillok.Media\Sillok.Media.csproj" />
    <Compile Include="..\Sillok.Core.Tests\NativeLibraryDir.cs" Link="NativeLibraryDir.cs" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
